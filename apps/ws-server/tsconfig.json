{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Node runs the .ts files directly, so tsc only type-checks.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
